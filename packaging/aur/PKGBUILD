# Maintainer: Multipak contributors <https://github.com/MinaSaad47/multipak>
pkgname=multipak
pkgver=0.1.0
pkgrel=1
pkgdesc='Create and run multiple isolated instances of Flatpak apps, each with its own data folder'
arch=('x86_64' 'aarch64')
url='https://github.com/MinaSaad47/multipak'
license=('MIT OR Apache-2.0')
depends=('flatpak' 'gcc-libs' 'glibc' 'libglvnd' 'libxkbcommon' 'wayland' 'libx11' 'libxcursor' 'libxi' 'libxrandr')
makedepends=('cargo' 'git')
optdepends=(
    'xdg-desktop-portal: native file and folder pickers'
    'xdg-utils: open data folders in the file manager'
    'desktop-file-utils: refresh the application menu cache after changes'
)
source=("$pkgname::git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release -p multipak
}

check() {
    cd "$pkgname"
    export RUSTUP_TOOLCHAIN=stable
    cargo test --frozen --workspace
}

package() {
    cd "$pkgname"
    install -Dm755 target/release/multipak "$pkgdir/usr/bin/multipak"
    install -Dm644 packaging/multipak.desktop "$pkgdir/usr/share/applications/multipak.desktop"
    install -Dm644 packaging/multipak.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/multipak.svg"
    install -Dm644 crates/multipak-gui/assets/multipak-256.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/multipak.png"
    install -Dm644 packaging/io.github.minasaad47.Multipak.metainfo.xml "$pkgdir/usr/share/metainfo/io.github.minasaad47.Multipak.metainfo.xml"
    install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
    install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
